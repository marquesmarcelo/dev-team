FROM node:20-alpine
WORKDIR /app
EXPOSE 3000
# npm install na inicialização garante módulos atualizados sem rebuild da imagem.
# O volume nomeado frontend_node_modules isola node_modules do diretório do host,
# evitando conflito entre node_modules do Linux (container) e Windows/Mac (host).
CMD ["sh", "-c", "npm install && npm run dev"]
