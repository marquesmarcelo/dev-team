# Copie este arquivo para .env e preencha os valores antes de subir o ambiente.
# NUNCA comite o .env com valores reais — apenas este .env.example.

# ── Banco de dados ──────────────────────────────────────────────────────────
POSTGRES_DB=app_dev
POSTGRES_USER=app_user
POSTGRES_PASSWORD=troque_antes_de_usar
DATABASE_URL=postgres://app_user:troque_antes_de_usar@postgres:5432/app_dev?sslmode=disable

# ── Backend ─────────────────────────────────────────────────────────────────
PORT=3001
GIN_MODE=release               # "debug" em dev (sobrescrito pelo compose.dev.yml)
APP_ENV=production             # "development" sobrescrito pelo compose.dev.yml
CORS_ALLOWED_ORIGINS=http://localhost:3000
# DEV_SEM_AUTH=true            # Bypass de autenticação — SOMENTE em dev local
                               # Já configurado no docker-compose.dev.yml.
                               # Nunca habilitar em produção.

# ── Frontend ─────────────────────────────────────────────────────────────────
BACKEND_URL=http://backend:3001

# ── Teste de carga (k6) ──────────────────────────────────────────────────────
K6_API_BASE_URL=http://backend:3001
